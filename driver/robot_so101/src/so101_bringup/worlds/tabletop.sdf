<?xml version="1.0"?>
<sdf version="1.9">
  <world name="so101_tabletop">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.3 0.35 0.38 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 2 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
    <!-- The robot spawns at z=0. This tabletop provides contact at that height. -->
    <model name="tabletop"><static>true</static><pose>0 0 -0.025 0 0 0</pose><link name="surface">
      <collision name="collision"><geometry><box><size>1.2 1.2 0.05</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.2 1.2 0.05</size></box></geometry><material><ambient>0.55 0.56 0.52 1</ambient><diffuse>0.55 0.56 0.52 1</diffuse></material></visual>
    </link></model>
    <model name="red_cube"><pose>0.22 0.05 0.016 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency></plugin>
      <link name="cube">
      <inertial><mass>0.03</mass><inertia><ixx>0.00000512</ixx><iyy>0.00000512</iyy><izz>0.00000512</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.032 0.032 0.032</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.032 0.032 0.032</size></box></geometry><material><ambient>0.8 0.03 0.02 1</ambient><diffuse>0.8 0.03 0.02 1</diffuse></material></visual>
    </link></model>
    <!-- A non-colliding visible destination on the tabletop. -->
    <model name="green_target"><static>true</static><pose>0.19 -0.12 0.0005 0 0 0</pose><link name="target">
      <visual name="border"><geometry><box><size>0.09 0.09 0.001</size></box></geometry><material><ambient>0.02 0.7 0.1 1</ambient><diffuse>0.02 0.7 0.1 1</diffuse></material></visual>
      <visual name="inside"><pose>0 0 0.001 0 0 0</pose><geometry><box><size>0.075 0.075 0.001</size></box></geometry><material><ambient>0.55 0.56 0.52 1</ambient><diffuse>0.55 0.56 0.52 1</diffuse></material></visual>
    </link></model>
    <model name="top_camera"><static>true</static><pose>0.55 0 0.55 0 0.75 3.14159265</pose><link name="camera_link">
      <sensor name="rgb" type="camera"><always_on>true</always_on><update_rate>30</update_rate><topic>/top_camera/image</topic><camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.03</near><far>5</far></clip></camera></sensor>
    </link></model>
  </world>
</sdf>
