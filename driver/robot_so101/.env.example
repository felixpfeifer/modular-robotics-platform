# Copy to .env. Everything can also be set with ./so101 options.
RMW=zenoh                 # zenoh | cyclonedds | fastdds
ROS_DOMAIN_ID=0

FOLLOWER_BACKEND=mock     # mock | gazebo | real
LEADER_BACKEND=mock

# Prefer stable names from /dev/serial/by-id/ when they exist.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# Files in config/calibration/, seen as /calibration/<name> in the container.
FOLLOWER_CALIBRATION=
LEADER_CALIBRATION=

# WSL2: /mnt/wslg/.X11-unix   Native Linux or Jetson: /tmp/.X11-unix
X11_SOCKET=/mnt/wslg/.X11-unix

# Zenoh across machines: point at the router host (default is this machine).
# ZENOH_CONFIG_OVERRIDE=connect/endpoints=["tcp/192.168.1.10:7447"];scouting/multicast/enabled=false
