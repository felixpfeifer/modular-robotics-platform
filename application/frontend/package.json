{
  "name": "mrp-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "eslint .",
    "check": "yarn format:check && yarn lint && yarn test && yarn build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "MRP_E2E_REAL=1 playwright test --project=real"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@tanstack/react-query": "^5.108.4",
    "axios": "^1.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router": "^8.5.3",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "1.55.0",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "6.4.6",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,css,html,json,md}": "prettier --write"
  }
}
