FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-media.txt /app/
RUN python3 -m pip install --no-cache-dir -r /app/requirements.txt -r /app/requirements-media.txt
COPY backend /app/backend
RUN for package in git git-man; do if dpkg -s "$package" >/dev/null 2>&1; then apt-get purge -y "$package" || exit 1; fi; done && ! command -v git
ENV PYTHONPATH=/app/backend MRP_DATA_DIR=/data/application
EXPOSE 8088
CMD ["python3", "-m", "mrp_app", "--mode", "demo", "--host", "0.0.0.0"]
