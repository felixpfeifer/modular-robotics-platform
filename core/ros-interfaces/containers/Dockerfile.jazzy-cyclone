ARG ROS_BASE_IMAGE=docker.io/library/ros:jazzy-ros-base@sha256:31daab66eef9139933379fb67159449944f4e2dcf2e22c2d12cc715f29873e0f
FROM ${ROS_BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
       build-essential \
       git \
       make \
       python3-colcon-common-extensions \
       python3-pytest \
       python3-venv \
       ros-jazzy-ament-lint-common \
       ros-jazzy-diagnostic-msgs \
       ros-jazzy-rmw-cyclonedds-cpp \
       ros-jazzy-rosidl-default-generators \
       ros-jazzy-unique-identifier-msgs \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/platform-tools \
    && /opt/platform-tools/bin/pip install --no-cache-dir \
       commitizen==3.29.1 \
       pre-commit==3.8.0

COPY containers/cyclonedds.xml /opt/platform/cyclonedds.xml
COPY scripts/ /opt/platform-ci/
COPY tools/ /opt/platform-tools/repository-tools/
RUN chmod 0555 /opt/platform-ci/*.sh /opt/platform-tools/repository-tools/*.py

ENV PATH="/opt/platform-tools/bin:${PATH}" \
    ROS_DISTRO=jazzy \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=file:///opt/platform/cyclonedds.xml \
    ROS_DOMAIN_ID=87

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/opt/platform-ci/container-verify.sh"]
