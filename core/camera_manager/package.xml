<?xml version="1.0"?>
<package format="3">
  <name>camera_manager</name>
  <version>0.1.0</version>
  <description>Hardware-independent multi-camera manager core and ROS 2 node.</description>
  <maintainer email="maintainers@example.invalid">camera_manager maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>opencv4</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
