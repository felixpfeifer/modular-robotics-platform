FROM docker.io/felixpfeifer/mrp-ros-base:latest
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg python3-venv ros-jazzy-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/
WORKDIR /app
COPY recorder/pyproject.toml recorder/uv.lock ./
ENV UV_PROJECT_ENVIRONMENT=/opt/export
RUN uv sync --frozen --no-dev && rm -rf /root/.cache/uv
COPY recorder/episode_recorder_py /app/episode_recorder_py
COPY recorder/config /app/config
RUN for package in git git-man; do if dpkg -s "$package" >/dev/null 2>&1; then apt-get purge -y "$package" || exit 1; fi; done && ! command -v git
ENV PATH="/opt/export/bin:$PATH" PYTHONPATH="/app"
ENTRYPOINT ["/bin/bash", "-c", "source /opt/platform/install/setup.bash && exec python /app/episode_recorder_py/export_lerobot.py \"$@\"", "--"]
