<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>episode_recorder</name>
  <version>0.2.0</version>
  <description>Teleoperation episode recorder for LeRobot dataset generation</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcutils</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_transport</depend>
  <depend>platform_common_interfaces</depend>
  <depend>platform_control_interfaces</depend>
  <depend>platform_episode_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>python3-opencv</depend>
  <depend>python3-yaml</depend>
  <depend>nlohmann-json3-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
